#!/usr/bin/env python3
"""Omarchy theme-set hook: recolour Thunderbird's "Mailspring Modern" theme.

Reads the current Omarchy theme's colors.toml and writes omarchy-colors.css
into the Thunderbird profile's chrome/ folder, which userChrome.css and
userContent.css import. Thunderbird only reads it at startup, so a theme
change shows up the next time Thunderbird is opened. Delete
omarchy-colors.css (and this hook) to go back to the built-in Mailspring
palette.
"""

import configparser
import pathlib
import re
import sys
import tomllib

HOME = pathlib.Path.home()
COLORS = HOME / ".local/state/omarchy/current/theme/colors.toml"
HEX = re.compile(r"^#[0-9a-fA-F]{6}$")


def read_ini(path):
    parser = configparser.ConfigParser(interpolation=None, strict=False)
    parser.read(path)
    return {name: dict(parser[name]) for name in parser.sections()}


def find_profile():
    """The profile Thunderbird starts with (same logic as lib/find-profile)."""
    for base in (
        HOME / ".config/thunderbird",
        HOME / ".thunderbird",
        HOME / ".var/app/org.mozilla.Thunderbird/.thunderbird",
    ):
        profiles_ini = base / "profiles.ini"
        if not profiles_ini.is_file():
            continue
        profiles = read_ini(profiles_ini)
        candidates = []
        installs_ini = base / "installs.ini"
        if installs_ini.is_file():
            candidates += [s.get("default") for s in read_ini(installs_ini).values()]
        candidates += [s.get("default") for name, s in profiles.items() if name.lower().startswith("install")]
        candidates += [
            s.get("path")
            for name, s in profiles.items()
            if name.lower().startswith("profile") and s.get("default") == "1"
        ]
        candidates += [s.get("path") for name, s in profiles.items() if name.lower().startswith("profile")]
        for candidate in candidates:
            if not candidate:
                continue
            path = pathlib.Path(candidate)
            path = path if path.is_absolute() else base / path
            if path.is_dir():
                return path
    return None


def luminance(hex_color):
    def channel(value):
        value /= 255
        return value / 12.92 if value <= 0.03928 else ((value + 0.055) / 1.055) ** 2.4

    r, g, b = (int(hex_color[i:i + 2], 16) for i in (1, 3, 5))
    return 0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b)


def readable_on(hex_color):
    lum = luminance(hex_color)
    return "#000000" if (lum + 0.05) / 0.05 > 1.05 / (lum + 0.05) else "#ffffff"


def main():
    profile = find_profile()
    if profile is None or not (profile / "chrome").is_dir():
        return 0
    out = profile / "chrome" / "omarchy-colors.css"

    if not COLORS.is_file():
        out.unlink(missing_ok=True)
        return 0

    with COLORS.open("rb") as f:
        theme = tomllib.load(f)

    def color(*keys):
        for key in keys:
            value = theme.get(key)
            if isinstance(value, str) and HEX.match(value):
                return value
        return None

    bg = color("background")
    fg = color("foreground")
    accent = color("accent", "blue", "cyan")
    if not (bg and fg and accent):
        # Not enough to build a palette; fall back to the Mailspring colours.
        out.unlink(missing_ok=True)
        return 0

    light = theme.get("mode") == "light"

    def mix(color_a, percent, color_b):
        return f"color-mix(in srgb, {color_a} {percent}%, {color_b})"

    sidebar = color("dark_background") or mix(bg, 75, "black" if not light else "white")
    raised = color("lighter_background") or mix(fg, 8, bg)
    accent_text = mix(accent, 70, "black") if light else accent
    selected_unfocused = color("selection") or mix(accent, 18, bg)

    tokens = {
        "--ms-accent": accent,
        "--ms-accent-strong": accent,
        "--ms-accent-text": accent_text,
        "--ms-on-accent": readable_on(accent),
        "--ms-bg": bg,
        "--ms-bg-sidebar": sidebar,
        "--ms-bg-raised": raised,
        "--ms-hover": mix(fg, 7, "transparent"),
        "--ms-row-hover": mix(accent, 8, bg),
        "--ms-row-selected-unfocused": selected_unfocused,
        "--ms-border": mix(fg, 12, bg),
        "--ms-text": fg,
        "--ms-text-subtle": mix(fg, 65, bg),
        "--layout-background-2": mix(fg, 5, bg),
        "--layout-background-3": mix(fg, 9, bg),
        "--layout-background-4": mix(fg, 14, bg),
        "--layout-color-3": mix(fg, 50, bg),
        "--layout-border-1": mix(fg, 16, bg),
        "--layout-border-2": mix(fg, 24, bg),
    }

    theme_name = sys.argv[1] if len(sys.argv) > 1 else "current theme"
    lines = [
        "/* Generated by ~/.config/omarchy/hooks/theme-set.d/thunderbird-colors",
        f"   from the Omarchy theme \"{theme_name}\". Rewritten on every theme change;",
        "   delete this file to use the built-in Mailspring palette. */",
        "",
        "@media not (prefers-contrast) {",
        "  /* :root:root outranks the fallback palette in theme-tokens.css */",
        "  :root:root {",
        *(f"    {name}: {value} !important;" for name, value in tokens.items()),
        "  }",
        "}",
        "",
    ]
    tmp = out.with_suffix(".css.tmp")
    tmp.write_text("\n".join(lines))
    tmp.replace(out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
